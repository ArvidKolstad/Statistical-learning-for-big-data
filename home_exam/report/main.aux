\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces In this plot we can see the Expected Calibration Error ploted over the sample size. We can see that the accuracy increases with sample sizes but that RDA is slightly better when having enough training data.}}{15}{figure.7}\protected@file@percent }
\newlabel{fig:expectedcalibration}{{7}{15}{In this plot we can see the Expected Calibration Error ploted over the sample size. We can see that the accuracy increases with sample sizes but that RDA is slightly better when having enough training data}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces In this figure the blue bars shows the models own confidence in its predictions against the real accuracy of those predictions. We can also see the frequency of the models confidence in the red bars. For kNN we see that the highest frequency is the confidence 0.9-1.0 which is good. But it also has a lot of guesses lower than this. On the other hand RDA is almost always certaion of its classifications and when it isn't it has a good accuracy of it's guesse and has a almost perfect prediction.}}{16}{figure.8}\protected@file@percent }
\newlabel{fig:ModelConfidenceAccuracy}{{8}{16}{In this figure the blue bars shows the models own confidence in its predictions against the real accuracy of those predictions. We can also see the frequency of the models confidence in the red bars. For kNN we see that the highest frequency is the confidence 0.9-1.0 which is good. But it also has a lot of guesses lower than this. On the other hand RDA is almost always certaion of its classifications and when it isn't it has a good accuracy of it's guesse and has a almost perfect prediction}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Here are the models classifications balance for the two classes. The biggest differance between the clasifications is class 3 and class 6. Otherwise are the fractions almost the same.}}{16}{figure.9}\protected@file@percent }
\newlabel{fig:classdist}{{9}{16}{Here are the models classifications balance for the two classes. The biggest differance between the clasifications is class 3 and class 6. Otherwise are the fractions almost the same}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Here we see the classification confidence for each class over different sample sizes of training. We see that class 3 is lowest for the kNN which could explain the difference that was seen in the class balance predictions.}}{17}{figure.10}\protected@file@percent }
\newlabel{fig:confclass}{{10}{17}{Here we see the classification confidence for each class over different sample sizes of training. We see that class 3 is lowest for the kNN which could explain the difference that was seen in the class balance predictions}{figure.10}{}}
