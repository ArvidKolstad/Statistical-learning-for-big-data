\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Class distribution of the training dataset under the extreme imbalance condition. Class 1 constitutes the vast majority of samples (90.9\%), while Classes 2–7 each account for approximately 1.5\% of observations, reflecting a severely skewed class distribution used to evaluate classifier robustness under extreme imbalance.}}{20}{figure.11}\protected@file@percent }
\newlabel{fig:balance4}{{11}{20}{Class distribution of the training dataset under the extreme imbalance condition. Class 1 constitutes the vast majority of samples (90.9\%), while Classes 2–7 each account for approximately 1.5\% of observations, reflecting a severely skewed class distribution used to evaluate classifier robustness under extreme imbalance}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Distribution of accuracy and macro-averaged F1-score across classifiers under the extreme class imbalance condition. Box plots display the median, interquartile range, and outliers for KNN, LogReg, RDA, and the hierarchical classifier. While accuracy is uniformly high across all methods due to class imbalance, F1-score reveals greater variation, with Hierarchy and RDA achieving the highest median performance.}}{21}{figure.12}\protected@file@percent }
\newlabel{fig:performance4}{{12}{21}{Distribution of accuracy and macro-averaged F1-score across classifiers under the extreme class imbalance condition. Box plots display the median, interquartile range, and outliers for KNN, LogReg, RDA, and the hierarchical classifier. While accuracy is uniformly high across all methods due to class imbalance, F1-score reveals greater variation, with Hierarchy and RDA achieving the highest median performance}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Per-class accuracy as a function of training sample size under the extreme imbalance condition, shown separately for each classifier (KNN, LogReg, RDA, Hierarchy). Each line corresponds to one of the seven classes. The dominant class Class 1 consistently achieves high accuracy across all sample sizes and classifiers, while minority classes Classes 2–7 exhibit greater variability and generally lower accuracy, particularly at small sample sizes.}}{21}{figure.13}\protected@file@percent }
\newlabel{ fig:class4}{{13}{21}{Per-class accuracy as a function of training sample size under the extreme imbalance condition, shown separately for each classifier (KNN, LogReg, RDA, Hierarchy). Each line corresponds to one of the seven classes. The dominant class Class 1 consistently achieves high accuracy across all sample sizes and classifiers, while minority classes Classes 2–7 exhibit greater variability and generally lower accuracy, particularly at small sample sizes}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Pairwise Bayesian comparisons of classifier performance under the extreme imbalance condition. Results indicate that RDA and Hierarchy are largely equivalent to each other, while both substantially outperform KNN and LogReg with high posterior probability.}}{22}{figure.14}\protected@file@percent }
\newlabel{fig:bayes4}{{14}{22}{Pairwise Bayesian comparisons of classifier performance under the extreme imbalance condition. Results indicate that RDA and Hierarchy are largely equivalent to each other, while both substantially outperform KNN and LogReg with high posterior probability}{figure.14}{}}
